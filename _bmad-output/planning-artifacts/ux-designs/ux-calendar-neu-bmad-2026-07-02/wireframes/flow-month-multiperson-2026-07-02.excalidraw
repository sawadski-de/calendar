      "link": null,
      "locked": false,
      "index": "bB",
      "text": "3 kleine Punkte pro Tag = M, B, K (v.l.n.r.), gefärbt nach\nvorherrschendem Tagesstatus je Person.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "3 kleine Punkte pro Tag = M, B, K (v.l.n.r.), gefärbt nach\nvorherrschendem Tagesstatus je Person.",
      "lineHeight": 1.25
    },
