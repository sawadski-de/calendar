      "index": "cJ",
      "text": "3 dünne horizontale Balken gestapelt = M, B, K (oben nach\nunten), gefärbt nach vorherrschendem Tagesstatus je Person.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "3 dünne horizontale Balken gestapelt = M, B, K (oben nach\nunten), gefärbt nach vorherrschendem Tagesstatus je Person.",
      "lineHeight": 1.25
    },
