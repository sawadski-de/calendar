      "isDeleted": false,
      "boundElements": null,
      "updated": 1751500000000,
      "link": null,
      "locked": false,
      "index": "bD",
      "text": "Tradeoff: Sehr kompakt, passt in jede Monatszelle - zeigt\naber nicht, WANN am Tag der Status gilt, nur eine grobe\nZusammenfassung (\"vorherrschend\") pro Person und Tag.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Tradeoff: Sehr kompakt, passt in jede Monatszelle - zeigt\naber nicht, WANN am Tag der Status gilt, nur eine grobe\nZusammenfassung (\"vorherrschend\") pro Person und Tag.",
      "lineHeight": 1.25
    },
