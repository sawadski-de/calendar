# Copy this file to deploy/.env and adjust values before running `docker compose up`.

# --- Postgres ---
POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=change-me-in-production

# --- Caddy ---
# Host port Caddy binds to. Defaults to 8090 (not 80) so local dev doesn't collide
# with another service already bound to port 80 on the host; production deployments
# should override this to 80/443 with TLS as appropriate.
CADDY_HTTP_PORT=8090

# --- Api ---
ASPNETCORE_ENVIRONMENT=Production

# Initial admin account, created once on first Api startup if no admin exists yet (Story 1.1, AC 10).
# The default below already satisfies ASP.NET Core Identity's default password policy
# (uppercase + lowercase + digit + non-alphanumeric, 6+ chars) — change it before any real deployment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin#12345

# OAuth token encryption at rest (AD-8, Story 2.1). Must be a base64-encoded 32-byte key for AES-256-GCM
# — generate one with e.g. `openssl rand -base64 32`. Both Api (initial handshake) and Worker (refresh +
# decrypt-before-call) read this. The placeholder below is NOT valid base64/32 bytes — replace it before
# starting the stack, both processes fail fast at startup otherwise.
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-key-placeholder

# --- Google Calendar sync (Story 2.1) ---
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console, scope
# https://www.googleapis.com/auth/calendar.readonly. Redirect URI must exactly match what's registered
# there and point at this deployment's own origin, e.g. https://your-domain/api/calendar-connections/google/callback.
# Both Api and Worker need the client secret — Google's refresh_token grant requires it too.
GOOGLE_OAUTH_CLIENT_ID=change-me
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8090/api/calendar-connections/google/callback

# --- Outlook/Microsoft 365 calendar sync (Story 2.2) ---
# Register an app in Azure AD / Microsoft Entra admin center, API permission Calendars.Read
# (delegated). Redirect URI must exactly match what's registered there.
MICROSOFT_OAUTH_CLIENT_ID=change-me
MICROSOFT_OAUTH_CLIENT_SECRET=change-me
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8090/api/calendar-connections/outlook/callback
# "common" accepts consent from any Microsoft Entra tenant — set to a specific tenant id if the team
# is on one known Microsoft 365 tenant (see Story 2.2 open questions).
MICROSOFT_OAUTH_TENANT_ID=common

# How often the Worker polls connected calendars, in seconds (NFR-1: "a few minutes", no fixed number
# specified — 300s/5min is this project's default).
SYNC_INTERVAL_SECONDS=300
