# Copy this file to deploy/.env and adjust values before running `docker compose up`.

# --- Postgres ---
POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=change-me-in-production

# --- Caddy ---
# Host port Caddy binds to. Defaults to 8090 (not 80) so local dev doesn't collide
# with another service already bound to port 80 on the host; production deployments
# should override this to 80/443 with TLS as appropriate.
CADDY_HTTP_PORT=8090

# --- Api ---
ASPNETCORE_ENVIRONMENT=Production

# Initial admin account, created once on first Api startup if no admin exists yet (Story 1.1, AC 10).
# The default below already satisfies ASP.NET Core Identity's default password policy
# (uppercase + lowercase + digit + non-alphanumeric, 6+ chars) — change it before any real deployment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin#12345

# Placeholder for OAuth token encryption, introduced in Epic 2 (AD-8) — not used by this story yet.
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-key-placeholder
